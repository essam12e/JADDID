# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase project URL and anon key — public, RLS-enforced. Browser + server.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service_role key — bypasses RLS. Server-only, never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Resend API key and verified sending address. Server-only.
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@your-domain.com

# Public app URL used in email templates and OpenGraph metadata. No localhost in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
